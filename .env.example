# Public (safe for browser): URL + anon key only. RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY - never prefix with NEXT_PUBLIC_. Used for audit writes / admin user creation.
SUPABASE_SERVICE_ROLE_KEY=

# Used for email-verification redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave unset in production. Set to false only to test a production build over plain http locally.
# ENFORCE_HTTPS=false
